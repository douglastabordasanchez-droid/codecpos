        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "⚡ COMPILAR RAPIDO (solo pack)",
      "type": "npm",
      "script": "pack",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
