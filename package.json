{
  "name": "codecpos",
  "version": "2.0.1",
  "description": "Sistema de Punto de Venta Profesional - Codec Studio",
  "author": "Codec Studio <contacto@codecstudio.com> (https://codecstudio.online)",
  "license": "SEE LICENSE IN electron/assets/LICENSE.txt",
  "private": true,
  "main": "electron/main.js",
  "homepage": "https://codecstudio.online/",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "server:install": "if [ -d server ]; then cd server && npm install; else echo 'Server directory not found, skipping...'; fi",
    "rebuild": "electron-rebuild -f -w serialport",
    "postinstall": "echo Skipping native rebuild",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "precheck": "node scripts/pre-build-check.js",
    "verify": "node scripts/verificar-pre-compilacion.js",
    "check:syntax": "node scripts/check-syntax-errors.js",
    "diagnostico": "node scripts/diagnostico-rapido.js",
    "icon:generate": "node scripts/create-ico.js",
    "clean": "node scripts/clean-build.js",
    "voz:descargar": "node scripts/download-piper-voice.js",
    "electron:build": "npm run electron:build:win",
    "electron:build:win": "npm run clean && npm run voz:descargar && npm run check:syntax && npm run verify && npm run precheck && npx vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --config electron/builder-config.js",
    "electron:build:win:publish": "npm run clean && npm run voz:descargar && npm run check:syntax && npm run verify && npm run precheck && npx vite build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win --x64 --publish always --config electron/builder-config.js",
    "electron:build:all": "npm run clean && npm run voz:descargar && npm run check:syntax && npm run verify && npm run precheck && npx vite build && electron-builder -mwl --config electron/builder-config.js",
    "pack": "npm run clean && npm run voz:descargar && npx vite build && electron-builder --dir --config electron/builder-config.js",
    "dist": "npm run clean && npm run voz:descargar && npm run build && electron-builder --config electron/builder-config.js",
    "compile": "npm run electron:build:win",
    "compile:quick": "npm run pack",
    "compile:clean": "npm run clean && npm run electron:build:win",
    "compile:release": "node scripts/compile-release.js",
    "test:build": "npm run pack && echo Build test completed",
    "start:compile": "npm run clean && npm run voz:descargar && npm run build && npx electron-builder --win nsis --config electron/builder-config.js",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test": "vitest run",
    "dev:pwa": "vite --config vite.config.pwa.ts",
    "build:pwa": "vite build --config vite.config.pwa.ts",
    "dev:admin": "vite --config vite.config.admin.ts",
    "build:admin": "vite build --config vite.config.admin.ts",
    "dev:landing": "npx serve landing -l 4174",
    "dev:trial-flow": "concurrently \"npm run dev:pwa\" \"npm run dev:landing\""
  },
